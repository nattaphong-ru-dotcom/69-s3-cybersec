# =============================================
# TEMPLATE ตัวอย่าง - คัดลอกไปเป็น .env แล้วเติมค่าจริง
# ห้าม commit .env (อยู่ใน .gitignore แล้ว)
# =============================================

DATABASE_DB=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_HOST=db
DATABASE_CLIENT=postgres

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# =============================================
# REST Client (ใช้กับ api.rest) — key ต้องตรงกับ {{$dotenv ...}} ในไฟล์ .rest
# =============================================
BASE_URL=http://localhost:8080

# Admin
# สร้าง admin อัตโนมัติถ้า DB ว่าง (true/false)
AUTO_CREATE_ADMIN=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NEW_PASSWORD=
# token จาก 1.1 Login (Admin) — ใช้กับ 1.5 Profile
# ถ้าหมดอายุหรือได้ 401 ให้ยิง 1.1 ใหม่แล้วคัดลอกค่า data.token มาวางทับตรงนี้
ADMIN_TOKEN=
# firstname บังคับสำหรับ /admin/register-admin
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
# = วาง reset_token จาก admin_users หลังยิง forgot-password
ADMIN_RESET_TOKEN=

# User (กรอกตามบัญชีที่สมัครไว้จริง)
USER_NAME=
USER_EMAIL=
USER_PASSWORD=
USER_NEW_PASSWORD=
# =============================================
# JWT ของ user ข้างบน — ใช้ให้ section 3 ยิงได้โดยไม่ต้องกด 2.1 ก่อน
# วิธี refresh: ยิง 2.1 Login (User) แล้ว copy ค่า "jwt" จาก response มาวางทับบรรทัดนี้
# อายุ token = 30 วัน | ถ้าหมดอายุจะได้ 401
# =============================================
USER_TOKEN=
# = วาง code/ป้าย reset หลังยิง forgot-password
USER_RESET_TOKEN=

# =============================================
# Content Section (3) — Student / Subject / Teacher / Mapping
# หมายเหตุ: mobile ต้องยาว 10 หลัก, cardId ยาว 13 หลัก (บังคับโดย schema)
# mobile เก็บเป็นค่าจริง ไม่ถูก hash (โค้ดอยู่ที่ strapi-src/api/student/ ใน repo)
# =============================================
STUDENT_NAME=
# mobile และ cardId เป็น unique -> 3.1.1 ใช้ {{$randomInt}} สร้างค่าสองตัวนี้แทนแล้ว
# เก็บไว้เป็นค่าตัวอย่างเท่านั้น
STUDENT_MOBILE=
STUDENT_CARD_ID=
STUDENT_NEW_NAME=
# mobile เป็น unique -> 3.1.4 ใช้ {{$randomInt 8000000000 8999999999}} แทนค่านี้แล้ว
# เก็บไว้เป็นค่าตัวอย่างเท่านั้น
STUDENT_NEW_MOBILE=
# id ของ student ข้างบน — ใช้กับ 3.1.3 / 3.1.4 (ดูจาก response ของ 3.1.1 ที่ data.id)
# ค่านี้ต้องเป็นตัวเลข ถ้าไม่ใช่จะได้ 404
STUDENT_ID=

# name เป็น unique -> ค่าชื่อต้องไม่ซ้ำกับที่มีอยู่ใน DB ไม่งั้น 3.2.1 ได้ 400 This attribute must be unique
# วิธีทำงาน: แก้ค่าใน .env นี้ก่อนยิง 3.2.1 ทุกครั้ง (เช่นเติม ครั้ง, a, b ...)
# ไม่ใช้ {{$guid}} / {{$timestamp}} ต่อท้ายชื่อ เพราะ humao.rest-client 0.25.1
# ตัดตัวแปรพวกนั้นทิ้งจาก body (ตรวจจาก log ของ server แล้ว) ทำให้ชนชื่อเดิมทุกครั้ง
SUBJECT_NAME=
SUBJECT_NEW_NAME=
# id ของ subject ข้างบน — ใช้กับ 3.2.3 / 3.2.4 และ 3.4.1
# ค่านี้ต้องเป็นตัวเลข ถ้าไม่ใช่จะได้ 404 (controller กัน id ผิดรูปแบบไว้แล้ว)
SUBJECT_ID=

# name เป็น unique -> เหตุผลเดียวกับ SUBJECT_NAME ข้างบน ต้องแก้ค่าใน .env ก่อนยิง 3.3.1
TEACHER_NAME=
TEACHER_NEW_NAME=
# id ของ teacher ข้างบน — ใช้กับ 3.3.3 / 3.3.4 และ 3.4.1
TEACHER_ID=

# =============================================
# Mapping (3.4) — เชื่อม Subject เข้ากับ Teacher ผ่าน collection "mappings"
# ตาราง mapping: subjects (oneToMany -> subject) + teacher (manyToOne -> teacher)
# หมายเหตุ: ต้อง grant permission api::mapping.mapping.* ให้ role Authenticated ก่อน
# =============================================
MAPPING_NOTE=
# id ของ mapping ข้างบน — ใช้กับ 3.4.3 / 3.4.4
MAPPING_ID=
